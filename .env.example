# Supabase (collection de cartes). Copier en .env.local et renseigner :
# - en local : valeurs affichées par `npx supabase start`
# - en production : Project Settings > API (clé « anon » publique, jamais la clé service_role)
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=

# Notifications push : clé publique VAPID (publique, à mettre aussi dans Netlify).
# Générer la paire avec : node scripts/vapid-keys.mjs
VITE_VAPID_PUBLIC_KEY=
